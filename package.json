{
  "name": "@openma/dsh-mcp-apps",
  "version": "0.0.2",
  "description": "MCP Apps Host and renderer bundle for DeepSeek Harness",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/openma-ai/dsh-mcp-apps.git"
  },
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./host": {
      "types": "./lib/host.d.ts",
      "default": "./lib/host.js"
    },
    "./web": {
      "types": "./lib/web.d.ts",
      "default": "./lib/web.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "workspaces": [
    "packages/*"
  ],
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dependencies": {
    "@openma/dsh-mcp-apps-host": "0.0.2",
    "@openma/dsh-mcp-apps-web": "0.0.2"
  },
  "scripts": {
    "build:root": "tsc -p tsconfig.root.json",
    "build:host": "npm run build --workspace @openma/dsh-mcp-apps-host",
    "build:web": "npm run build --workspace @openma/dsh-mcp-apps-web",
    "build:example:display-modes": "tsdown --config examples/display-modes/tsdown.config.ts",
    "build": "npm run build:root && npm run build:host && npm run build:web && npm run build:example:display-modes",
    "prepack": "npm run build",
    "pretest": "npm run build",
    "test": "vitest run --exclude apps/web/tests/**/*.e2e.spec.ts",
    "pretest:browser": "npm run build:example:display-modes",
    "test:browser": "vitest run apps/web/tests/mcp-app-sandbox.e2e.spec.ts",
    "typecheck": "tsc -p tsconfig.root.json --noEmit && npm run typecheck --workspaces --if-present",
    "release:publish": "node scripts/publish.mjs"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.1",
    "@deepseek-ai/cordis-plugin-loader": "1.0.2",
    "@deepseek-ai/dsh-api-gateway": "0.1.0-rc.6",
    "@deepseek-ai/dsh-client-runtime": "0.1.0-rc.6",
    "@deepseek-ai/dsh-client-ui-tool": "0.1.0-rc.6",
    "@deepseek-ai/dsh-invariants": "0.1.0-rc.6",
    "@deepseek-ai/dsh-typert-protocol": "0.1.0-rc.6",
    "@modelcontextprotocol/ext-apps": "1.7.5",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@testing-library/react": "^16.1.0",
    "@types/node": "^24.0.0",
    "@types/react": "~18.3.1",
    "@types/react-dom": "~18.3.1",
    "jsdom": "^26.1.0",
    "lightningcss": "^1.30.2",
    "playwright": "^1.55.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tsdown": "^0.22.2",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8",
    "zod": "^4.4.3"
  },
  "engines": {
    "node": ">=20"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/cordis-plugin-loader": ">=1.0.2 <2"
  }
}
