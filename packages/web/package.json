{
  "name": "@openma/dsh-mcp-apps-web",
  "version": "0.1.1",
  "description": "Sandboxed MCP Apps Web renderer for DeepSeek Harness",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/openma-ai/dsh-mcp-apps.git",
    "directory": "packages/web"
  },
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/client.js.map",
    "lib/types/**/*.d.ts"
  ],
  "dsh": {
    "client": {
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-tool"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && tsdown --config tsdown.config.ts",
    "prepack": "npm run build",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/ext-apps": "1.7.5",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@openma/dsh-mcp-apps-host": "0.1.1",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-api-remotes": ">=0.1.0-rc.6 <1 || >=0.1.1-rc.1 <0.1.1",
    "@deepseek-ai/dsh-client-runtime": ">=0.1.0-rc.6 <1 || >=0.1.1-rc.1 <0.1.1",
    "@deepseek-ai/dsh-client-ui-tool": ">=0.1.0-rc.6 <1 || >=0.1.1-rc.1 <0.1.1",
    "react": "^18.2.0"
  }
}
